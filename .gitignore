# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local embedded database + env
.data/

# database backups (npm run db:export) — contain encrypted tokens, keep private
/backups/

# preserved copy of the corrupted 2026-07-19 dev db (safe to delete later)
.data-corrupt*/
# pre-recovery snapshots of the dev db — same encrypted-token caveat as /backups/
.data-backup*/
.superpowers/

# generated dealer-sheet conversion dump (2.9MB, punch #39 Task 7) — the
# reviewed/staged subset lives at scripts/starter-import-data.json instead,
# which IS committed. Regenerate via `python3 scripts/convert-dealer-sheets.py`.
/dealer-import-data.json
.data-dirty*/
.data-*/

# local git worktrees (superpowers:using-git-worktrees)
/.worktrees/
