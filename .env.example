# ---- Required in every environment ----
# Session encryption secret. Generate with: npx auth secret   (or any random 32+ bytes, base64)
AUTH_SECRET=

# ---- Database (production) ----
# Neon/Vercel Postgres connection string. Leave unset locally: dev uses the
# embedded PGlite database in .data/pglite automatically.
DATABASE_URL=

# ---- Google SSO (production sign-in) ----
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). See DEPLOY.md for the exact steps + redirect URIs.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Dev sign-in ----
# true = show the "sign in as a team member" picker (no password).
# Automatically on in local dev while Google isn't configured. NEVER set true in production.
AUTH_DEV_LOGIN=

# Leave blank for plain sign-in (Vercel sets this for you).
# AUTH_URL=https://your-app.vercel.app

# ---- Native shell (optional, local tooling only) ----
# Capacitor's remote/hybrid shell loads this URL in the native WebView. Leave
# unset for the production Quartzite deployment; set it to a LAN URL when
# testing the shell against `npm run dev` on a physical device.
# CAPACITOR_SERVER_URL=https://quartzite-six.vercel.app

# ---- Daily maintenance cron ----
# Shared secret for the /api/drive/sync cron endpoint (venue address stamp + the
# ETC daily price sync). On Vercel, setting this env var makes Vercel Cron send
# it automatically as `Authorization: Bearer <value>`; any external pinger can
# do the same. Any long random string (e.g. `openssl rand -hex 32`). Leave
# blank to disable the endpoint.
CRON_SECRET=

# Vercel Blob (D116, MASTER-HOWTO §9) — datasheets, catalog photos, documents,
# estimate drawings and saved quote PDFs. Unset = uploads that need Blob are
# refused (dev keeps quote PDFs under QUOTE_PDF_DIR).
# Store token: Vercel dashboard → peak-app → Storage → the Blob store.
BLOB_READ_WRITE_TOKEN=

# Displays Manager read-only API (optional). When set, external callers use
# Authorization: Bearer <value> against /api/v1/displays/*; without it the
# endpoints require the normal signed-in app session.
DISPLAYS_API_TOKEN=

# Saved quote PDFs (#222). Local dev prints with the installed Google Chrome;
# set CHROME_PATH if it isn't at the macOS default. Vercel uses the bundled
# @sparticuz/chromium. Without BLOB_READ_WRITE_TOKEN, dev keeps the files under
# QUOTE_PDF_DIR (default .data/files). QUOTE_PDF_ORIGIN pins the address the
# headless browser prints from — REQUIRED IN PRODUCTION (the app's public URL,
# e.g. https://quartzite-six.vercel.app; Production scope only, DEPLOY.md §7).
# Unset, the request's own host is used on Vercel and in local dev; a
# production server off Vercel refuses to render without it.
# QUOTE_PDF_DISABLED=1 turns rendering off (saves still succeed; the PDF reads
# "failed" with the reason).
# CHROME_PATH=
# QUOTE_PDF_DIR=
# QUOTE_PDF_ORIGIN=
# QUOTE_PDF_DISABLED=
# Preview deployments behind Vercel Deployment Protection: the automation bypass
# secret lets the headless browser reach the print page.
# VERCEL_AUTOMATION_BYPASS_SECRET=

# --- ETC price sync (#368) ---
# The MyETC API key is pasted in Catalog → Import price book → Connect a
# manufacturer (stored encrypted with AUTH_SECRET); no env var holds it.
# ETC_SYNC_DISABLED=true        # kill switch: refuses every ETC action and skips the daily sync
