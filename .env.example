# ---- Required in every environment ----
# Session encryption secret. Generate with: npx auth secret   (or any random 32+ bytes, base64)
AUTH_SECRET=

# ---- Database (production) ----
# Neon/Vercel Postgres connection string. Leave unset locally: dev uses the
# embedded PGlite database in .data/pglite automatically.
DATABASE_URL=

# ---- Google SSO (production sign-in) ----
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). See DEPLOY.md for the exact steps + redirect URIs.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Dev sign-in ----
# true = enable local/preview sign-in. It is hard-disabled for the live
# production deployment. For a Vercel Preview, set this there too.
AUTH_DEV_LOGIN=
# Required for preview sign-in: a private code shared with preview users.
# Never commit the real value or configure this in Vercel Production.
AUTH_DEV_ACCESS_CODE=

# Set to the deployed URL if the host doesn't provide it automatically
# (Vercel sets this for you; leave blank there).
# AUTH_URL=https://your-app.vercel.app

# ---- Gmail integration (Phase 7 — optional, off by default) ----
# The whole Gmail feature is INERT unless this is exactly "true" AND the
# Google OAuth vars above are set. Turn it on only after enabling the Gmail
# API + adding the Gmail scopes and the /api/gmail/callback redirect URI to
# the SAME Google Cloud project used for sign-in (see DEPLOY.md §5). Tokens
# are encrypted at rest with AUTH_SECRET. Leave blank to keep the Inbox in
# simulated mode.
GMAIL_ENABLED=
# Only if the OAuth callback origin differs from AUTH_URL (rare). Must match a
# redirect URI registered in Google Cloud, e.g. https://your-app.vercel.app
# GMAIL_REDIRECT_BASE=
# Shared secret for the /api/gmail/sync cron endpoint (server-side inbox sync,
# D74). On Vercel, setting this env var makes Vercel Cron send it automatically
# as `Authorization: Bearer <value>`; any external pinger can do the same. Any
# long random string (e.g. `openssl rand -hex 32`). Leave blank to disable the
# endpoint — a long-running server still syncs via its built-in boot timer.
CRON_SECRET=

# ---- AI features (Phase 8 — optional, off by default) ----
# The whole AI layer (renewal drafts, thread/customer summaries, import
# extraction, quote-scope drafting, the Assistant) is INERT until this is set.
# Create a key at console.anthropic.com. AI only ever DRAFTS — a person always
# reviews and sends. Leave blank to keep the app exactly as it is without AI.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-4-8; e.g. claude-haiku-4-5
# for a cheaper tier). Optional kill switch: AI_DISABLED=true forces AI off even
# with a key present. Optional per-request timeout in ms (default 60000).
# ANTHROPIC_MODEL=
# AI_DISABLED=
# AI_TIMEOUT_MS=

# Vercel Blob (D116, MASTER-HOWTO §9) — plan sheets (and later datasheets)
# out of the database. Unset = files stay as data-URLs in the DB.
# Store token: Vercel dashboard → peak-app → Storage → the Blob store.
BLOB_READ_WRITE_TOKEN=
