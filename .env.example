# ---- Required in every environment ----
# Session encryption secret. Generate with: npx auth secret   (or any random 32+ bytes, base64)
AUTH_SECRET=

# ---- Database (production) ----
# Neon/Vercel Postgres connection string. Leave unset locally: dev uses the
# embedded PGlite database in .data/pglite automatically.
DATABASE_URL=

# ---- Google SSO (production sign-in) ----
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). See DEPLOY.md for the exact steps + redirect URIs.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Dev sign-in ----
# true = show the "sign in as a team member" picker (no password).
# Automatically on in local dev while Google isn't configured. NEVER set true in production.
AUTH_DEV_LOGIN=

# Set to the deployed URL if the host doesn't provide it automatically
# (Vercel sets this for you; leave blank there).
# AUTH_URL=https://your-app.vercel.app

# ---- Gmail integration (Phase 7 — optional, off by default) ----
# The whole Gmail feature is INERT unless this is exactly "true" AND the
# Google OAuth vars above are set. Turn it on only after enabling the Gmail
# API + adding the Gmail scopes and the /api/gmail/callback redirect URI to
# the SAME Google Cloud project used for sign-in (see DEPLOY.md §5). Tokens
# are encrypted at rest with AUTH_SECRET. Leave blank to keep the Inbox in
# simulated mode.
GMAIL_ENABLED=
# Only if the OAuth callback origin differs from AUTH_URL (rare). Must match a
# redirect URI registered in Google Cloud, e.g. https://your-app.vercel.app
# GMAIL_REDIRECT_BASE=
